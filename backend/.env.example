# Server
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=moneymitra

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# OTP
# In development the OTP is returned in the API response and logged to the
# console instead of being sent by SMS, so you can test without an SMS
# provider. Wire a real gateway (MSG91, Twilio, etc.) in src/utils/otp.js
# before going to production, and set this to "false".
OTP_DEBUG_MODE=true
